<Page
    x:Class="VrcTranslate.Desktop.Pages.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="Transparent" AutomationProperties.Name="语音">
    <Grid.Transitions>
      <TransitionCollection>
        <EntranceThemeTransition FromVerticalOffset="10" />
      </TransitionCollection>
    </Grid.Transitions>
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Top"
                  SizeChanged="OnViewportSizeChanged">
      <Grid HorizontalAlignment="Stretch">
        <StackPanel x:Name="ContentColumn"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    Spacing="14"
                    Margin="30,24,30,32">
          <Border x:Name="VoiceStatusPanel"
                  Background="#EAF2FF"
                  BorderBrush="#BBD3F7"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14">
            <Grid x:Name="VoiceStatusGrid" ColumnSpacing="12" RowSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="VoiceStatusDotHost"
                    Grid.RowSpan="2"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center">
                <Border x:Name="VoiceStatusBadge"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="#D9E9FF" />
                <FontIcon Glyph="&#xE720;"
                          FontSize="20"
                          Foreground="#2D73D5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <ProgressRing x:Name="VoicePulse"
                              Width="40"
                              Height="40"
                              IsActive="False"
                              Visibility="Collapsed"
                              Foreground="#2D73D5" />
              </Grid>
              <Grid Grid.Column="1"
                    Grid.RowSpan="2"
                    x:Name="VoiceStatusLine"
                    ColumnSpacing="16"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            Spacing="3"
                            VerticalAlignment="Center">
                  <TextBlock x:Name="VoiceStatusText"
                             Text="他人语音识别停止"
                             FontSize="16"
                             FontWeight="SemiBold" />
                  <!-- 紧凑采集来源徽标：只显示当前来源，不新增卡片、下拉或配置项。 -->
                  <Border x:Name="VoiceCaptureSourceBadge"
                          HorizontalAlignment="Left"
                          Background="#E3EEFF"
                          BorderBrush="#BBD3F7"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,1"
                          Visibility="Collapsed"
                          AutomationProperties.AutomationId="voice-capture-source"
                          AutomationProperties.Name="当前采集来源">
                    <TextBlock x:Name="VoiceCaptureSourceText"
                               Text="系统声音"
                               FontSize="12"
                               Foreground="#2D73D5" />
                  </Border>
                </StackPanel>
                <!-- The meter fills whatever the title leaves; idle bars keep
                     its place visible while nothing is being said. -->
                <Grid Grid.Column="1"
                      x:Name="VoiceAudioLevelHost"
                      MinWidth="90"
                      VerticalAlignment="Center">
                  <StackPanel x:Name="VoiceAudioLevel"
                              Height="24"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False" />
                </Grid>
              </Grid>
              <StackPanel x:Name="VoiceStatusActions"
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button x:Name="VoiceStartButton"
                        Content="开始"
                        Width="92"
                        Height="36"
                        MinWidth="92"
                        Click="OnStartClicked"
                        AutomationProperties.Name="开始识别"
                        Background="#2D73D5"
                        Foreground="#FFFFFF" />
              </StackPanel>
              <StackPanel x:Name="VoiceHotkeySummary"
                          Grid.Row="1"
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="他人语音快捷键">
                <TextBlock Text="他人语音"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />
                <Border Background="#DCE8F7"
                        CornerRadius="4"
                        Padding="7,2"
                        MinWidth="38">
                  <!-- Filled from the persisted setting on load (未设置 when the
                       user cleared it), never from a shipped default here. -->
                  <TextBlock x:Name="VoiceHotkeyValue"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#2D73D5"
                             TextAlignment="Center"
                             AutomationProperties.AutomationId="voice-hotkey-summary" />
                </Border>
                <TextBlock Text="开始 / 停止他人语音识别"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="12">
              <!-- 浮窗没有独立开关：它随他人语音识别一起出现和消失（D3）。 -->
              <StackPanel Spacing="3">
                <TextBlock Text="字幕窗口"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="跟随他人语音识别自动显示 / 隐藏"
                           Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="透明度"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        x:Name="SubtitleOverlayOpacitySlider"
                        AutomationProperties.AutomationId="subtitle-overlay-opacity"
                        Minimum="60"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        ValueChanged="OnSubtitleOverlayOpacityChanged"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           x:Name="SubtitleOverlayOpacityValue"
                           Text="90%"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
              <!-- 与透明度同级：只切换消息条里是否带原文，不新增卡片或下拉。 -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="字幕内容"
                           VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1"
                              x:Name="SubtitleContentToggle"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              OnContent="译文 + 原文"
                              OffContent="仅译文"
                              Toggled="OnSubtitleContentToggled"
                              AutomationProperties.AutomationId="subtitle-content-toggle"
                              AutomationProperties.Name="字幕消息内容" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <Grid ColumnSpacing="14" RowSpacing="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="本地语音模型"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#16202E" />
                <TextBlock x:Name="ModelStatus"
                           Text="本地模型未安装"
                           FontSize="12"
                           Foreground="#607083"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1"
                      x:Name="ConfigureModelButton"
                      Content="管理模型"
                      Click="OnConfigureModelClicked"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="管理本地语音模型" />
              <ComboBox Grid.Row="1"
                        Grid.ColumnSpan="2"
                        x:Name="SpeechModelBox"
                        AutomationProperties.AutomationId="speech-model-box"
                        SelectedIndex="0"
                        SelectionChanged="OnSpeechModelChanged"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Tag="local" Content="SenseVoice Small · 中 / 英 / 日 / 韩（含粤语）" />
              </ComboBox>
            </Grid>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="10">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Text="说话人"
                             FontSize="17"
                             FontWeight="SemiBold"
                             Foreground="#16202E" />
                  <TextBlock x:Name="SpeakerStatus"
                             Text="他人语音暂不区分说话人"
                             FontSize="12"
                             Foreground="#607083"
                             TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="SpeakerToggle"
                              AutomationProperties.Name="区分说话人"
                              OnContent="区分"
                              OffContent="不区分"
                              Toggled="OnSpeakerToggleToggled" />
              </Grid>
              <ListView x:Name="SpeakerList"
                        MaxHeight="170"
                        SelectionMode="Single"
                        SelectionChanged="OnSpeakerSelectionChanged"
                        AutomationProperties.AutomationId="speaker-list"
                        BorderThickness="1"
                        CornerRadius="8" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SpeakerRenameButton"
                        Content="命名"
                        Click="OnRenameSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerMergeButton"
                        Content="合并到…"
                        Click="OnMergeSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerForgetButton"
                        Content="忘记"
                        Click="OnForgetSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerClearButton"
                        Content="清空声纹库"
                        Click="OnClearSpeakersClicked" />
              </StackPanel>
            </StackPanel>
          </Border>

          <InfoBar x:Name="VoiceInfo" IsOpen="False" IsClosable="True" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
