<Application
    x:Class="VrcTranslate.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#D4DFEC" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
      </Style>
      <Style x:Key="AccentSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="#E8F5F3" />
        <Setter Property="BorderBrush" Value="#B7DDD7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
      </Style>
      <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#16202E" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#16202E" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Margin" Value="0,0,0,2" />
      </Style>
      <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#5B6D82" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#2D73D5" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="CharacterSpacing" Value="80" />
      </Style>
      <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#16202E" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      </Style>
      <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="#D8E2F0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="6,0,6,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
      </Style>
      <Style x:Key="NavIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Width" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#C8D5E8" />
      </Style>
      <Style x:Key="NavLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="#C8D5E8" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
      </Style>
      <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="10,6" />
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#111827" />
      <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#D8E2F0" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFF" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
