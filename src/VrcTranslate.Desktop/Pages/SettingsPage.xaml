<Page
    x:Class="VrcTranslate.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" SizeChanged="OnViewportSizeChanged">
    <Grid HorizontalAlignment="Stretch" MinWidth="0">
      <StackPanel x:Name="ContentColumn" MaxWidth="900" HorizontalAlignment="Center" Spacing="14" Margin="24,20,24,30">
        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
          <StackPanel Spacing="14">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8" Background="#E8F0FF"><FontIcon Glyph="&#xE765;" FontSize="17" Foreground="#2774C7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="快捷键" Style="{StaticResource SectionTitleTextStyle}" />
              </StackPanel>
              <Button Grid.Column="1" Content="恢复默认" Click="OnResetHotkeysClicked" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="HotkeyGrid" ColumnSpacing="14" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock x:Name="QuickInputHotkeyLabel" Text="打开输入框" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="QuickInputHotkeyBox" Grid.Column="1" PlaceholderText="例如 Ctrl+Alt+I" TextChanged="OnSettingTextChanged" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown" />
              <TextBlock x:Name="QuickInputHotkeyHint" Grid.Column="2" Text="打开 / 关闭输入框" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
              <TextBlock x:Name="VoiceHotkeyLabel" Grid.Row="1" Text="字幕" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="VoiceHotkeyBox" Grid.Row="1" Grid.Column="1" PlaceholderText="例如 F7" TextChanged="OnSettingTextChanged" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown" />
              <TextBlock x:Name="VoiceHotkeyHint" Grid.Row="1" Grid.Column="2" Text="打开 / 关闭字幕" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
              <TextBlock x:Name="SelfVoiceHotkeyLabel" Grid.Row="2" Text="自身语音" VerticalAlignment="Center" />
              <TextBox x:Name="SelfVoiceHotkeyBox" Grid.Row="2" Grid.Column="1" PlaceholderText="例如 Ctrl+F8" TextChanged="OnSettingTextChanged" LostFocus="OnHotkeyBoxLostFocus" KeyDown="OnHotkeyBoxKeyDown" />
              <TextBlock x:Name="SelfVoiceHotkeyHint" Grid.Row="2" Grid.Column="2" Text="打开 / 关闭自身语音" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
          <StackPanel Spacing="12">
            <Grid x:Name="OscHeaderGrid" ColumnSpacing="12" RowSpacing="4" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel x:Name="OscHeaderTitle" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8" Background="#E6F6F1"><FontIcon Glyph="&#xE71B;" FontSize="17" Foreground="#16866E" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="OSC 连接" Style="{StaticResource SectionTitleTextStyle}" />
              </StackPanel>
              <TextBlock x:Name="OscHeaderHint" Grid.Column="1" Text="VRChat 内需开启 OSC" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="OscGrid" ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBox x:Name="OscHostBox" Grid.Column="0" Header="主机" PlaceholderText="127.0.0.1" TextChanged="OnSettingTextChanged" />
              <TextBox x:Name="OscPortBox" Grid.Column="1" Header="端口" PlaceholderText="9000" TextChanged="OnSettingTextChanged" />
            </Grid>
            <InfoBar x:Name="SettingsInfo" IsOpen="False" Severity="Success" />
            <TextBlock x:Name="StorageNotice"
                       TextWrapping="Wrap"
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
