<Page
    x:Class="VrcTranslate.Desktop.Pages.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" SizeChanged="OnViewportSizeChanged">
    <Grid HorizontalAlignment="Stretch" MinWidth="0">
    <StackPanel x:Name="ContentColumn" MaxWidth="760" HorizontalAlignment="Center" Spacing="14" Margin="24,20,24,30">
      <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
        <Grid ColumnSpacing="14" RowSpacing="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="8" Background="#FFF2DD"><FontIcon Glyph="&#xE8A1;" FontSize="17" Foreground="#C7771C" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="屏幕翻译" Style="{StaticResource SectionTitleTextStyle}" />
          </StackPanel>
          <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="QQ 截图翻译" FontSize="14" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#EEF3F8" CornerRadius="5" Padding="10,5"><TextBlock Text="Ctrl+Alt+F" FontSize="13" FontWeight="SemiBold" Foreground="#2D73D5" /></Border>
          </Grid>
          <Border Grid.Row="2" Height="1" Background="#E6ECF3" />
          <StackPanel Grid.Row="3" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="9"><Border Width="32" Height="32" CornerRadius="8" Background="#E8F0FF"><FontIcon Glyph="&#xE765;" FontSize="17" Foreground="#2774C7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="应用快捷键" Style="{StaticResource SectionTitleTextStyle}" /></StackPanel>
            <Grid ColumnSpacing="10" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="打开输入框" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="打开 / 关闭输入框" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="2" Background="#EEF3F8" CornerRadius="5" Padding="10,5"><TextBlock x:Name="GuideQuickInputHotkey" FontSize="13" FontWeight="SemiBold" /></Border>
              <TextBlock Grid.Row="1" Text="他人语音" VerticalAlignment="Center" /><TextBlock Grid.Row="1" Grid.Column="1" Text="开始 / 停止他人语音识别" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" /><Border Grid.Row="1" Grid.Column="2" Background="#EEF3F8" CornerRadius="5" Padding="10,5"><TextBlock x:Name="GuideOtherPlayerVoiceHotkey" FontSize="13" FontWeight="SemiBold" /></Border>
              <TextBlock Grid.Row="2" Text="自身语音" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Grid.Column="1" Text="打开 / 关闭自身语音" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" /><Border Grid.Row="2" Grid.Column="2" Background="#EEF3F8" CornerRadius="5" Padding="10,5"><TextBlock x:Name="GuideSelfVoiceHotkey" FontSize="13" FontWeight="SemiBold" /></Border>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 软件不附带密钥：这里只给控制台直达与额度要点（以官网为准），
           不写图文教程、不代注册、不代领额度。 -->
      <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border Width="32" Height="32" CornerRadius="8" Background="#E9F6F1"><FontIcon Glyph="&#xE8D7;" FontSize="17" Foreground="#16866E" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="翻译服务配置" Style="{StaticResource SectionTitleTextStyle}" />
          </StackPanel>
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="软件不附带密钥：用哪家就去哪家控制台开通并创建密钥，回到「翻译 → 新增档案」粘贴保存即可。额度与价格以官网为准。" />
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="腾讯云" FontWeight="SemiBold" VerticalAlignment="Center" />
              <HyperlinkButton Content="① 开通机器翻译" NavigateUri="https://console.cloud.tencent.com/tmt"
                               Padding="0" AutomationProperties.AutomationId="guide-tencent-console" />
              <HyperlinkButton Content="② 创建 API 密钥" NavigateUri="https://console.cloud.tencent.com/cam/capi"
                               Padding="0" AutomationProperties.AutomationId="guide-tencent-keys" />
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="开通「机器翻译 TMT」即可使用；每月 500 万字符免费，额度当月有效、不结转（是否人人都有以官网为准）；超量 58 元/百万字符。" />
          </StackPanel>
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="阿里云" FontWeight="SemiBold" VerticalAlignment="Center" />
              <HyperlinkButton Content="① 开通机器翻译" NavigateUri="https://mt.console.aliyun.com/"
                               Padding="0" AutomationProperties.AutomationId="guide-aliyun-console" />
              <HyperlinkButton Content="② 创建 AccessKey" NavigateUri="https://ram.console.aliyun.com/manage/ak"
                               Padding="0" AutomationProperties.AutomationId="guide-aliyun-keys" />
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="建议创建 RAM 子账号并只授权「机器翻译」；通用版与专业版各每月 100 万字符免费（超量 50 / 60 元/百万字符，以官网为准）。" />
          </StackPanel>
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="DeepSeek" FontWeight="SemiBold" VerticalAlignment="Center" />
              <HyperlinkButton Content="打开控制台：API Keys" NavigateUri="https://platform.deepseek.com/api_keys"
                               Padding="0" AutomationProperties.AutomationId="guide-deepseek-console" />
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="充值使用；实测说 1 小时约 0.05 元（价格以官网为准）。" />
          </StackPanel>
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="小米 MiMo" FontWeight="SemiBold" VerticalAlignment="Center" />
              <HyperlinkButton Content="打开控制台：API Keys" NavigateUri="https://platform.xiaomimimo.com/#/console/api-keys"
                               Padding="0" AutomationProperties.AutomationId="guide-xiaomi-console" />
            </StackPanel>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="小米账号登录即可创建 API 密钥；实测说 1 小时约 0.04 元（价格以官网为准）。" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 各家模型对比（实验报告-识别与翻译.md 的实测结论）：
           价格是用户 2026-09-16 从官网/控制台核对的，会变动；延迟是本机 108 次调用中位数。
           这里是纯静态文案：不绑数据、不新增 x:Name，代码后置文件不需要改。 -->
      <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18"
              AutomationProperties.AutomationId="guide-comparison">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border Width="32" Height="32" CornerRadius="8" Background="#F1ECFA"><FontIcon Glyph="&#xE8A1;" FontSize="17" Foreground="#6B4FBB" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="模型对比" Style="{StaticResource SectionTitleTextStyle}" />
          </StackPanel>
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="延迟＝一次翻译请求的实测中位，不含本地识别。" />
          <Grid ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="模型" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Grid.Column="1" Text="延迟" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Grid.Column="2" Text="特点" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Grid.Column="3" Text="计费" Style="{StaticResource SecondaryTextStyle}" />
            <TextBlock Grid.Row="1" Text="阿里云 · 专业版" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="195 ms" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="日语最准，粤语不翻译" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="免费 100 万字符/月" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="腾讯云 · 文本翻译" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="220 ms" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="日语一般，个别词直译翻车" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="免费 500 万字符/月" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Text="阿里云 · 通用版" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="269 ms" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="日语好，英文好" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="3" Text="免费 100 万字符/月" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Text="deepseek-flash" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="495 ms" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="质量最高，粤语能翻译" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="3" Text="1 小时约 0.05 元（约 600 句）" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Text="小米 MiMo v2.5" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="696 ms" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="韩语最好，英文最好" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="3" Text="1 小时约 0.04 元（约 600 句）" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="推荐：不确定就先用「阿里云 专业版」；讲粤语、或觉得日语译得别扭，再换「deepseek-flash」。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="机翻免费额度合计 700 万字符/月（腾讯 500 万 + 阿里 100 万），重度使用也用不完。计费单位＝说 1 小时（约 600 句，每句 20 字），本机 2026-09-16 实测；价格会变动，请以官网为准。" />
        </StackPanel>
      </Border>


      <!-- 使用声明（免责叠甲）：软件免费开源、非官方、不改游戏、可能出错、费用自理、不外发数据。
           正文与仓库根目录的 DISCLAIMER.md 一致；改这里请同步改那份（两处都写死，故意不共享资源）。 -->
      <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18"
              AutomationProperties.AutomationId="guide-disclaimer">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border Width="32" Height="32" CornerRadius="8" Background="#EAF3EC"><FontIcon Glyph="&#xE897;" FontSize="17" Foreground="#2C7A4B" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="使用声明" Style="{StaticResource SectionTitleTextStyle}" />
          </StackPanel>
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="本软件按 MIT 许可证免费开源发布，无任何付费功能；使用风险由使用者自行承担。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="非官方：第三方个人项目，与 VRChat 官方及各翻译服务商均无隶属或合作关系。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="不修改游戏：不读写游戏进程、不注入、不改游戏文件；音频经 Windows 系统回环采集，字幕经 VRChat 官方的 OSC Chatbox 发送。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="可能出错：语音识别与机器翻译都可能出错，不保证译文正确、完整或及时，请勿用于需要准确性的场合。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="费用自理：翻译服务由你自行开通并填入密钥（密钥只保存在本机），调用产生的费用由你承担。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="不外发数据：不上报任何使用数据；语音识别在本机完成，只有待翻译文本会发送给你自己配置的翻译服务。" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                     Text="完整声明见仓库根目录的 DISCLAIMER.md。" />
        </StackPanel>
      </Border>

      <!-- 作者的小店（可选）：链接来自 v2-user-settings.json 的 ShopUrl，没填就整张卡片折叠。
           软件本身始终免费开源，卡片上必须写明这一点，避免看起来像「付费才能用」。 -->
      <Border x:Name="ShopCard" Style="{StaticResource SurfaceBorderStyle}" Padding="18"
              Visibility="Collapsed" AutomationProperties.AutomationId="guide-shop">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border Width="32" Height="32" CornerRadius="8" Background="#FDF0E7"><FontIcon Glyph="&#xE719;" FontSize="17" Foreground="#C4622D" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="作者的小店" Style="{StaticResource SectionTitleTextStyle}" />
          </StackPanel>
          <TextBlock x:Name="ShopDescription" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
          <HyperlinkButton x:Name="ShopLink" Padding="0" AutomationProperties.AutomationId="guide-shop-link" />
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
