<Window
    x:Class="VrcTranslate.Desktop.Pages.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The HWND region supplies the rounded shape; this root has no frame. -->
  <Grid x:Name="DragSurface"
        RequestedTheme="Dark"
        Background="#F20B1726"
        MinWidth="360"
        MinHeight="72"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.AutomationId="subtitle-overlay-surface">
    <Grid x:Name="CaptionLayout"
          Margin="10,8"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          AutomationProperties.AutomationId="subtitle-caption-frame">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="34" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- A small icon is the only persistent affordance on the surface. -->
      <Grid x:Name="ActivityMark"
            Grid.Column="0"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="subtitle-activity-mark">
        <Ellipse x:Name="PulseRing"
                 Width="27"
                 Height="27"
                 Fill="Transparent"
                 Stroke="#805FE1D4"
                 StrokeThickness="1"
                 Opacity="0.58"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="22"
                 Height="22"
                 Fill="#CC123A46"
                 Stroke="#AA63DCD1"
                 StrokeThickness="1"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False" />
        <FontIcon Glyph="&#xE720;"
                  FontSize="12"
                  Foreground="#D8FFF8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsHitTestVisible="False" />
      </Grid>

      <TextBlock x:Name="SubtitleText"
                 Grid.Column="2"
                 AutomationProperties.AutomationId="subtitle-text"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="#FFFFFF"
                 TextAlignment="Left"
                 TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis"
                 MaxLines="3"
                 Margin="4,0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
