<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VrcTranslate.Desktop</RootNamespace>
    <AssemblyName>VrcTranslate</AssemblyName>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Folder under assets\models\speech that holds the SenseVoiceSmall
         ONNX payload (model.int8.onnx + tokens.txt). -->
    <BundledSpeechModelDirectory>sensevoice</BundledSpeechModelDirectory>
    <BundledSpeechModelFile>model.int8.onnx</BundledSpeechModelFile>
    <BundledSpeechModelPath>..\..\assets\models\speech\$(BundledSpeechModelDirectory)</BundledSpeechModelPath>
    <!-- Pinned to the version referenced by VrcTranslate.Infrastructure; the
         native engine is re-copied into the publish output after stripping. -->
    <SherpaOnnxRuntimeVersion>1.13.8</SherpaOnnxRuntimeVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="logo-mark.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\default-glossary.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The speech model ships inside the package once tests\Import-BundledSpeechModel.ps1
         has placed the ONNX payload in assets\models\speech\sensevoice; the
         files are re-downloadable and therefore kept out of source control. -->
    <Content Condition="Exists('$(BundledSpeechModelPath)\$(BundledSpeechModelFile)')"
             Include="$(BundledSpeechModelPath)\**\*"
             Link="Models\$(BundledSpeechModelDirectory)\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\VrcTranslate.Core\VrcTranslate.Core.csproj" />
    <ProjectReference Include="..\VrcTranslate.Application\VrcTranslate.Application.csproj" />
    <ProjectReference Include="..\VrcTranslate.Infrastructure\VrcTranslate.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
  </ItemGroup>

  <Target Name="WarnWhenBundledSpeechModelMissing" BeforeTargets="Publish">
    <Warning Condition="!Exists('$(BundledSpeechModelPath)\$(BundledSpeechModelFile)')"
             Text="未找到内置语音模型 $(BundledSpeechModelDirectory)\$(BundledSpeechModelFile)，本次发布将回退为运行时下载；请先运行 tests\Import-BundledSpeechModel.ps1。" />
  </Target>

  <!-- The self-contained Windows App SDK deployment unconditionally copies its
       Windows AI stack (onnxruntime, DirectML, projections) and the old
       Whisper.net runtime pack copied native libraries for every RID. This app
       never calls the Windows AI APIs and ships win-x64 only, so strip that
       payload after publish. DirectML stays out until the optional GPU stage
       needs it. Verified by launching and starting recognition from the
       stripped output. -->
  <Target Name="StripUnusedRuntimePayload" AfterTargets="Publish">
    <ItemGroup>
      <PayloadToStrip Include="$(PublishDir)**\*.pdb" />
      <PayloadToStrip Include="$(PublishDir)onnxruntime_providers_shared.dll" />
      <PayloadToStrip Include="$(PublishDir)DirectML.dll" />
      <PayloadToStrip Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <PayloadToStrip Include="$(PublishDir)Microsoft.Windows.AI.*" />
      <PayloadToStrip Include="$(PublishDir)Microsoft.Windows.AI.winmd" />
      <PayloadToStrip Include="$(PublishDir)Microsoft.Graphics.Imaging*" />
      <PayloadToStrip Include="$(PublishDir)Microsoft.Graphics.Internal.Imaging*" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\linux-arm" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\linux-arm64" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\linux-x64" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\macos-arm64" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\macos-x64" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\win-arm64" />
      <ForeignRuntimeFolder Include="$(PublishDir)runtimes\win-x86" />
    </ItemGroup>
    <Delete Files="@(PayloadToStrip)" TreatErrorsAsWarnings="true" />
    <!-- MSBuild "*" globs do not enumerate directories reliably, so the foreign
         RID set is enumerated explicitly. -->
    <RemoveDir Directories="@(ForeignRuntimeFolder)" />
  </Target>

  <!-- The App SDK deployment and sherpa-onnx both contribute an
       onnxruntime.dll, and which copy survives the publish is an accident of
       copy order. Windows AI (the App SDK consumer) is stripped above, so the
       engine sherpa-onnx was actually built against is put back explicitly. -->
  <Target Name="RestoreSherpaNativeRuntime" AfterTargets="StripUnusedRuntimePayload">
    <PropertyGroup>
      <SherpaNativeSource>$(NuGetPackageRoot)org.k2fsa.sherpa.onnx.runtime.win-x64\$(SherpaOnnxRuntimeVersion)\runtimes\win-x64\native</SherpaNativeSource>
    </PropertyGroup>
    <Error Condition="!Exists('$(SherpaNativeSource)\sherpa-onnx-c-api.dll')"
           Text="未找到 sherpa-onnx 原生运行库 $(SherpaNativeSource)，发布包的语音识别将无法启动。" />
    <ItemGroup>
      <SherpaNativeRuntime Include="$(SherpaNativeSource)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SherpaNativeRuntime)" DestinationFolder="$(PublishDir)" />
  </Target>

  <Target Name="CopyGeneratedPageXbfToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <GeneratedPageXbf Include="$(TargetDir)Pages\*.xbf" />
      <GeneratedDesktopResource Include="$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf;$(TargetDir)VrcTranslate.pri;$(TargetDir)brand-icon.png" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)Pages" />
    <Copy SourceFiles="@(GeneratedPageXbf)" DestinationFiles="@(GeneratedPageXbf->'$(PublishDir)Pages\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GeneratedDesktopResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
