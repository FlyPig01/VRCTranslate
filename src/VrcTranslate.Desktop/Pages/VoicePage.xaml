<Page
    x:Class="VrcTranslate.Desktop.Pages.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="Transparent" AutomationProperties.Name="语音">
    <Grid.Transitions>
      <TransitionCollection>
        <EntranceThemeTransition FromVerticalOffset="10" />
      </TransitionCollection>
    </Grid.Transitions>
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Top"
                  SizeChanged="OnViewportSizeChanged">
      <Grid HorizontalAlignment="Stretch">
        <StackPanel x:Name="ContentColumn"
                    MaxWidth="900"
                    HorizontalAlignment="Center"
                    Spacing="14"
                    Margin="30,24,30,32">
          <!-- 启动自检与识别错误放在页面顶部：旧的 InfoBar 在最底部，用户看不到，
               正是"窗口永远为空"最难排查的原因之一。 -->
          <InfoBar x:Name="SpeechSelfTestInfo"
                   AutomationProperties.AutomationId="speech-self-test"
                   IsOpen="False"
                   IsClosable="True"
                   Severity="Error" />
          <InfoBar x:Name="VoiceInfo" IsOpen="False" IsClosable="True" />
          <Border x:Name="VoiceStatusPanel"
                  Background="#EAF2FF"
                  BorderBrush="#BBD3F7"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14">
            <Grid x:Name="VoiceStatusGrid" ColumnSpacing="12" RowSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="VoiceStatusDotHost"
                    Grid.RowSpan="2"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center">
                <Border x:Name="VoiceStatusBadge"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="#D9E9FF" />
                <FontIcon Glyph="&#xE720;"
                          FontSize="20"
                          Foreground="#2D73D5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <ProgressRing x:Name="VoicePulse"
                              Width="40"
                              Height="40"
                              IsActive="False"
                              Visibility="Collapsed"
                              Foreground="#2D73D5" />
              </Grid>
              <Grid Grid.Column="1"
                    Grid.RowSpan="2"
                    x:Name="VoiceStatusLine"
                    ColumnSpacing="16"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            Spacing="3"
                            VerticalAlignment="Center">
                  <TextBlock x:Name="VoiceStatusText"
                             Text="他人语音识别停止"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="#16202E" />
                  <!-- 紧凑采集来源徽标：只显示当前来源，不新增卡片、下拉或配置项。 -->
                  <Border x:Name="VoiceCaptureSourceBadge"
                          HorizontalAlignment="Left"
                          Background="#E3EEFF"
                          BorderBrush="#BBD3F7"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,1"
                          Visibility="Collapsed"
                          AutomationProperties.AutomationId="voice-capture-source"
                          AutomationProperties.Name="当前采集来源">
                    <TextBlock x:Name="VoiceCaptureSourceText"
                               Text="系统声音"
                               FontSize="12"
                               Foreground="#2D73D5" />
                  </Border>
                </StackPanel>
                <!-- The meter fills whatever the title leaves; idle bars keep
                     its place visible while nothing is being said. -->
                <Grid Grid.Column="1"
                      x:Name="VoiceAudioLevelHost"
                      MinWidth="90"
                      VerticalAlignment="Center">
                  <StackPanel x:Name="VoiceAudioLevel"
                              Height="24"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False" />
                </Grid>
              </Grid>
              <StackPanel x:Name="VoiceStatusActions"
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button x:Name="VoiceStartButton"
                        Content="开始"
                        Width="92"
                        Height="36"
                        MinWidth="92"
                        Click="OnStartClicked"
                        AutomationProperties.Name="开始识别"
                        Background="#2D73D5"
                        Foreground="#FFFFFF" />
              </StackPanel>
              <StackPanel x:Name="VoiceHotkeySummary"
                          Grid.Row="1"
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="他人语音快捷键">
                <TextBlock Text="他人语音"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />
                <Border Background="#DCE8F7"
                        CornerRadius="4"
                        Padding="7,2"
                        MinWidth="38">
                  <!-- Filled from the persisted setting on load (未设置 when the
                       user cleared it), never from a shipped default here. -->
                  <TextBlock x:Name="VoiceHotkeyValue"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#2D73D5"
                             TextAlignment="Center"
                             AutomationProperties.AutomationId="voice-hotkey-summary" />
                </Border>
                <TextBlock Text="开始 / 停止他人语音识别"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="12">
              <!-- 浮窗没有独立开关：它随他人语音识别一起出现和消失（D3）。 -->
              <StackPanel Spacing="3">
                <TextBlock Text="字幕窗口"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock Text="跟随他人语音识别自动显示 / 隐藏"
                           Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="透明度"
                           Foreground="#16202E"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        x:Name="SubtitleOverlayOpacitySlider"
                        AutomationProperties.AutomationId="subtitle-overlay-opacity"
                        Minimum="60"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        ValueChanged="OnSubtitleOverlayOpacityChanged"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           x:Name="SubtitleOverlayOpacityValue"
                           Text="90%"
                           TextAlignment="Right"
                           Foreground="#16202E"
                           VerticalAlignment="Center" />
              </Grid>
              <!-- 与透明度同级：只切换消息条里是否带原文，不新增卡片或下拉。 -->
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="字幕内容"
                           Foreground="#16202E"
                           VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1"
                              x:Name="SubtitleContentToggle"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              OnContent="译文 + 原文"
                              OffContent="仅译文"
                              Toggled="OnSubtitleContentToggled"
                              AutomationProperties.AutomationId="subtitle-content-toggle"
                              AutomationProperties.Name="字幕消息内容" />
              </Grid>
            </StackPanel>
          </Border>


          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="识别引擎"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#16202E" />
                <TextBlock Text="默认本地离线免费；云端只处理其他玩家的系统声音，自己的麦克风始终本地。实时流式版尚未接入，当前云端为按句识别。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="6">
                <RadioButton x:Name="LocalAsrRadio"
                             GroupName="AsrProvider"
                             Content="本地识别 · 离线免费"
                             Checked="OnAsrProviderChanged"
                             AutomationProperties.AutomationId="asr-local-radio" />
                <RadioButton x:Name="TencentAsrRadio"
                             GroupName="AsrProvider"
                             Content="腾讯云按句识别（非流式） · 5000 次/月免费"
                             Checked="OnAsrProviderChanged"
                             AutomationProperties.AutomationId="asr-tencent-radio" />
              </StackPanel>

              <TextBlock Text="云端首选实时（流式、延迟低、5 小时/月免费），将在下一版接入；当前版本先用按句识别验证英/日/韩效果。"
                         FontSize="12"
                         Foreground="#607083"
                         TextWrapping="Wrap" />

              <StackPanel x:Name="TencentAsrPanel" Spacing="10">
                <TextBlock Text="仅用于其他玩家（系统声音）；自己的麦克风仍使用本地 SenseVoice。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />

                <ComboBox x:Name="TencentLanguageBox"
                          Header="语言模式"
                          MinWidth="280"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnTencentLanguageChanged"
                          AutomationProperties.AutomationId="asr-tencent-language">
                  <ComboBoxItem Tag="16k_zh" Content="中文（普通话 / 方言） · 免费" />
                  <ComboBoxItem Tag="16k_en" Content="英语 · 免费" />
                  <ComboBoxItem Tag="16k_ja" Content="日语 · 免费" />
                  <ComboBoxItem Tag="16k_ko" Content="韩语 · 免费" />
                  <ComboBoxItem Tag="16k_zh-PY" Content="中英粤混合 · 免费" />
                  <ComboBoxItem Tag="16k_yue" Content="粤语 · 免费" />
                </ComboBox>
                <TextBlock Text="两种接口都必须先选语言，没有免费的自动语种识别。按句版不支持多语种自动；多语种自动只在实时版提供（16k_multi_lang，4.8 元/小时，无免费额度）。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />

                <TextBlock Text="按句识别每次成功调用计 1 次，短句也算 1 次；5000 次/月免费，超出后 3.2 元/千次（以官网为准）。后付费默认关闭，额度用尽会停服。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />

                <TextBox x:Name="TencentAppIdBox"
                         Header="AppID（纯数字，不是 SecretId）"
                         PlaceholderText="例如 1250000000"
                         AutomationProperties.AutomationId="asr-tencent-appid" />
                <TextBox x:Name="TencentSecretIdBox"
                         Header="SecretId"
                         PlaceholderText="AKID 开头"
                         AutomationProperties.AutomationId="asr-tencent-secretid" />
                <PasswordBox x:Name="TencentSecretKeyBox"
                             Header="SecretKey（留空保留已保存密钥）"
                             PasswordRevealMode="Peek"
                             AutomationProperties.AutomationId="asr-tencent-secretkey" />
                <TextBlock Text="AppID 是腾讯云账号的纯数字 ID；SecretId/SecretKey 在 API 密钥管理中创建。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button x:Name="SaveTencentAsrButton"
                          Content="保存并测试"
                          Click="OnSaveTencentAsrClicked"
                          AutomationProperties.AutomationId="asr-tencent-save" />
                  <Button x:Name="ClearTencentAsrButton"
                          Content="清除配置"
                          Click="OnClearTencentAsrClicked"
                          AutomationProperties.AutomationId="asr-tencent-clear" />
                  <TextBlock x:Name="TencentAsrStatus"
                             VerticalAlignment="Center"
                             FontSize="12"
                             Foreground="#607083"
                             Text="未配置" />
                  <HyperlinkButton Content="计费说明"
                                   NavigateUri="https://cloud.tencent.com/document/product/1093/35686"
                                   Padding="0"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="asr-tencent-pricing" />
                </StackPanel>

                <InfoBar x:Name="TencentAsrInfo"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         AutomationProperties.AutomationId="asr-tencent-info" />

                <TextBlock Text="云端失败会自动回退本地，无需设置。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />
                <TextBlock Text="音频会上传到腾讯云；声纹和说话人标签仍只保存在本机。"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <Grid ColumnSpacing="14" RowSpacing="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="本地语音模型（离线 / 云端回退）"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#16202E" />
                <TextBlock x:Name="ModelStatus"
                           Text="本地模型未安装"
                           FontSize="12"
                           Foreground="#607083"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1"
                      x:Name="ConfigureModelButton"
                      Content="管理模型"
                      Click="OnConfigureModelClicked"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="管理本地语音模型" />
              <ComboBox Grid.Row="1"
                        Grid.ColumnSpan="2"
                        x:Name="SpeechModelBox"
                        AutomationProperties.AutomationId="speech-model-box"
                        SelectedIndex="0"
                        SelectionChanged="OnSpeechModelChanged"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Tag="local" Content="SenseVoice Small · 中 / 英 / 日 / 韩（含粤语）" />
              </ComboBox>
            </Grid>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="说话人"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#16202E" />
                <TextBlock x:Name="SpeakerStatus"
                           Text="已常驻开启 · 等待第一位说话人"
                           FontSize="12"
                           Foreground="#607083"
                           TextWrapping="Wrap" />
              </StackPanel>
              <ListView x:Name="SpeakerList"
                        MaxHeight="170"
                        SelectionMode="Single"
                        SelectionChanged="OnSpeakerSelectionChanged"
                        DisplayMemberPath="DisplayText"
                        AutomationProperties.AutomationId="speaker-list"
                        BorderThickness="1"
                        CornerRadius="8" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SpeakerRenameButton"
                        Content="命名"
                        Click="OnRenameSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerMergeButton"
                        Content="合并到…"
                        Click="OnMergeSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerForgetButton"
                        Content="忘记"
                        Click="OnForgetSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerClearButton"
                        Content="清空声纹库"
                        Click="OnClearSpeakersClicked" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
