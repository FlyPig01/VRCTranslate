<Page
    x:Class="VrcTranslate.Desktop.Pages.TranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                SizeChanged="OnViewportSizeChanged">
    <!-- Keep one bounded content column so cards and glossary rows share the
         same width on wide and narrow windows. -->
    <Grid HorizontalAlignment="Stretch" MinWidth="0">
      <StackPanel x:Name="ContentColumn"
                  MaxWidth="960"
                  HorizontalAlignment="Center"
                  Margin="24,24,24,36"
                  Spacing="16">
        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="20">
          <StackPanel Spacing="12" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12" MinWidth="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="翻译服务" Style="{StaticResource SectionTitleTextStyle}" />
              <Button Grid.Column="1"
                      Content="添加服务"
                      Click="OnNewServiceClicked"
                      AutomationProperties.AutomationId="translation-profile-add"
                      MinWidth="96" />
            </Grid>
            <StackPanel x:Name="ProfilesPanel"
                        Spacing="8"
                        HorizontalAlignment="Stretch" />
            <InfoBar x:Name="ResultInfo" IsOpen="False" Severity="Success" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="20">
          <StackPanel Spacing="12" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8" HorizontalAlignment="Stretch">
              <TextBlock Text="术语库" Style="{StaticResource SectionTitleTextStyle}" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <ToggleSwitch x:Name="GlossaryEnabledSwitch"
                              Header="启用"
                              IsOn="True" />
                <Button Content="保存"
                        Click="OnSaveGlossaryClicked"
                        AutomationProperties.AutomationId="glossary-save"
                        MinWidth="72" />
              </StackPanel>
            </StackPanel>

            <Grid ColumnSpacing="10" RowSpacing="8" MinWidth="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBox x:Name="TermSourceBox"
                       Grid.Column="0"
                       Header="原词"
                       PlaceholderText="输入原词"
                       MinWidth="0" />
              <TextBox x:Name="TermTargetBox"
                       Grid.Column="1"
                       Header="译词"
                       PlaceholderText="输入译词"
                       MinWidth="0" />
              <Button Grid.Row="1"
                      Grid.Column="1"
                      Content="添加"
                      Click="OnAddTermClicked"
                      HorizontalAlignment="Right"
                      MinWidth="72"
                      AutomationProperties.AutomationId="glossary-add" />
            </Grid>

            <Grid Background="#F4F7FB"
                  BorderBrush="#E3EAF3"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="12,8"
                  ColumnSpacing="10"
                  MinWidth="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="原词" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock Grid.Column="1" Text="译词" Style="{StaticResource SecondaryTextStyle}" />
              <TextBlock Grid.Column="2" Text="操作" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
            </Grid>

            <ListView x:Name="GlossaryList"
                      SelectionMode="None"
                      MaxHeight="300"
                      BorderThickness="0"
                      Padding="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,3" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Background="#F8FAFD"
                          BorderBrush="#E7EDF5"
                          BorderThickness="1"
                          CornerRadius="6"
                          HorizontalAlignment="Stretch"
                          MinWidth="0">
                    <Grid Padding="12,4"
                          ColumnSpacing="10"
                          HorizontalAlignment="Stretch"
                          MinWidth="0"
                          MinHeight="42">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Source}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 MinWidth="0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Target}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 MinWidth="0" />
                      <Button Grid.Column="2"
                              AutomationProperties.AutomationId="glossary-delete"
                              Width="72"
                              MinWidth="72"
                              Content="删除"
                              Tag="{Binding}"
                              Click="OnRemoveTermClicked" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="GlossaryEmptyText"
                       Text="暂无术语"
                       Style="{StaticResource SecondaryTextStyle}" />
            <InfoBar x:Name="GlossaryInfo" IsOpen="False" Severity="Success" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
