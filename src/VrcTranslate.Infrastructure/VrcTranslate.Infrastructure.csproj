<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- SenseVoiceSmall INT8 runs through the sherpa-onnx managed API; the
         win-x64 native package brings sherpa-onnx-c-api.dll and the
         onnxruntime.dll it was built against. The model itself ships in
         Models\sensevoice\ via the desktop project once
         Import-BundledSpeechModel.ps1 has placed it in assets. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
    <ProjectReference Include="..\VrcTranslate.Application\VrcTranslate.Application.csproj" />
    <!-- Granular NAudio packages instead of the NAudio metapackage: the meta
         package forces NAudio.WinForms, which drags the whole Windows Desktop
         (WinForms) runtime into the self-contained publish for code this app
         never calls. WindowsAudioCapture only needs WASAPI and WinMM. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>
</Project>
