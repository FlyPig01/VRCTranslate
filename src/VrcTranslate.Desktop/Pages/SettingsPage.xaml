<Page
    x:Class="VrcTranslate.Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <!-- The shortcut editors are capture fields, not text boxes: WinUI's built-in
         TextBox delete button showed up as a bare "x" that looked like text and
         wiped the gesture, and TextBox has no public API to turn it off. -->
    <Style x:Key="HotkeyCaptureStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>
    <Style x:Key="HotkeyCaptureFieldStyle" TargetType="Border">
      <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
      <Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
  </Page.Resources>
  <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" SizeChanged="OnViewportSizeChanged">
    <Grid HorizontalAlignment="Stretch" MinWidth="0">
      <StackPanel x:Name="ContentColumn" MaxWidth="900" HorizontalAlignment="Center" Spacing="14" Margin="24,20,24,30">
        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
          <StackPanel Spacing="14">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8" Background="#E8F0FF"><FontIcon Glyph="&#xE765;" FontSize="17" Foreground="#2774C7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="快捷键" Style="{StaticResource SectionTitleTextStyle}" />
              </StackPanel>
              <Button Grid.Column="1" Content="恢复默认" Click="OnResetHotkeysClicked" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="HotkeyGrid" ColumnSpacing="14" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock x:Name="QuickInputHotkeyLabel" Text="打开输入框" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="QuickInputHotkeyBox" Grid.Column="1" Style="{StaticResource HotkeyCaptureStyle}" AutomationProperties.Name="打开输入框快捷键" Click="OnHotkeyCaptureClick" PreviewKeyDown="OnHotkeyCapturePreviewKeyDown" PreviewKeyUp="OnHotkeyCapturePreviewKeyUp" LostFocus="OnHotkeyCaptureLostFocus">
                <Border x:Name="QuickInputHotkeyField" Style="{StaticResource HotkeyCaptureFieldStyle}">
                  <StackPanel x:Name="QuickInputHotkeyKeys" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" />
                </Border>
              </Button>
              <TextBlock x:Name="QuickInputHotkeyHint" Grid.Column="2" Text="打开 / 关闭输入框" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
              <TextBlock x:Name="VoiceHotkeyLabel" Grid.Row="1" Text="他人语音" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button x:Name="VoiceHotkeyBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource HotkeyCaptureStyle}" AutomationProperties.Name="他人语音快捷键" Click="OnHotkeyCaptureClick" PreviewKeyDown="OnHotkeyCapturePreviewKeyDown" PreviewKeyUp="OnHotkeyCapturePreviewKeyUp" LostFocus="OnHotkeyCaptureLostFocus">
                <Border x:Name="VoiceHotkeyField" Style="{StaticResource HotkeyCaptureFieldStyle}">
                  <StackPanel x:Name="VoiceHotkeyKeys" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" />
                </Border>
              </Button>
              <TextBlock x:Name="VoiceHotkeyHint" Grid.Row="1" Grid.Column="2" Text="开始 / 停止他人语音识别" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
              <TextBlock x:Name="SelfVoiceHotkeyLabel" Grid.Row="2" Text="自身语音" VerticalAlignment="Center" />
              <Button x:Name="SelfVoiceHotkeyBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource HotkeyCaptureStyle}" AutomationProperties.Name="自身语音快捷键" Click="OnHotkeyCaptureClick" PreviewKeyDown="OnHotkeyCapturePreviewKeyDown" PreviewKeyUp="OnHotkeyCapturePreviewKeyUp" LostFocus="OnHotkeyCaptureLostFocus">
                <Border x:Name="SelfVoiceHotkeyField" Style="{StaticResource HotkeyCaptureFieldStyle}">
                  <StackPanel x:Name="SelfVoiceHotkeyKeys" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" />
                </Border>
              </Button>
              <TextBlock x:Name="SelfVoiceHotkeyHint" Grid.Row="2" Grid.Column="2" Text="打开 / 关闭自身语音" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18">
          <StackPanel Spacing="12">
            <Grid x:Name="OscHeaderGrid" ColumnSpacing="12" RowSpacing="4" HorizontalAlignment="Stretch">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel x:Name="OscHeaderTitle" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="8" Background="#E6F6F1"><FontIcon Glyph="&#xE71B;" FontSize="17" Foreground="#16866E" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="OSC 连接" Style="{StaticResource SectionTitleTextStyle}" />
              </StackPanel>
              <TextBlock x:Name="OscHeaderHint" Grid.Column="1" Text="VRChat 内需开启 OSC" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <Grid x:Name="OscGrid" ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBox x:Name="OscHostBox" Grid.Column="0" Header="主机" PlaceholderText="127.0.0.1" TextChanged="OnSettingTextChanged" />
              <TextBox x:Name="OscPortBox" Grid.Column="1" Header="端口" PlaceholderText="9000" TextChanged="OnSettingTextChanged" />
            </Grid>
            <InfoBar x:Name="SettingsInfo" IsOpen="False" Severity="Success" />
            <TextBlock x:Name="StorageNotice"
                       TextWrapping="Wrap"
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
