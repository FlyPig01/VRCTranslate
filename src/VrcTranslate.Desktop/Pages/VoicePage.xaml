<Page
    x:Class="VrcTranslate.Desktop.Pages.VoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="Transparent" AutomationProperties.Name="字幕">
    <Grid.Transitions>
      <TransitionCollection>
        <EntranceThemeTransition FromVerticalOffset="10" />
      </TransitionCollection>
    </Grid.Transitions>
    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Top"
                  SizeChanged="OnViewportSizeChanged">
      <Grid HorizontalAlignment="Stretch">
        <StackPanel x:Name="ContentColumn"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    Spacing="14"
                    Margin="28,24,28,28">
          <Border x:Name="VoiceStatusPanel"
                  Background="#EAF2FF"
                  BorderBrush="#BBD3F7"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,14">
            <Grid x:Name="VoiceStatusGrid" ColumnSpacing="12" RowSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="VoiceStatusDotHost"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center">
                <Ellipse x:Name="VoiceStatusDot"
                         Width="10"
                         Height="10"
                         Fill="#9AA8B8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <ProgressRing x:Name="VoicePulse"
                              Width="18"
                              Height="18"
                              IsActive="False"
                              Visibility="Collapsed"
                              Foreground="#2AA876" />
              </Grid>
              <TextBlock Grid.Column="1"
                         x:Name="VoiceStatusText"
                         Text="字幕已停止"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <StackPanel x:Name="VoiceStatusActions"
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button x:Name="VoiceStartButton"
                        Content="开始"
                        Width="82"
                        MinWidth="74"
                        Click="OnStartClicked"
                        AutomationProperties.Name="开始识别"
                        Background="#2D73D5"
                        Foreground="#FFFFFF" />
              </StackPanel>
              <ProgressBar Grid.Row="1"
                           Grid.Column="1"
                           x:Name="VoiceAudioLevel"
                           Minimum="0"
                           Maximum="100"
                           Value="0"
                           Height="4"
                           MaxWidth="320"
                           HorizontalAlignment="Stretch"
                           Background="#C8D8E8"
                           Foreground="#2AA876"
                           IsHitTestVisible="False" />
              <StackPanel x:Name="VoiceHotkeySummary"
                          Grid.Row="1"
                          Grid.Column="2"
                          Orientation="Horizontal"
                          Spacing="6"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="字幕快捷键">
                <TextBlock Text="快捷键"
                           Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" />
                <Border Background="#DCE8F7"
                        CornerRadius="4"
                        Padding="7,2"
                        MinWidth="38">
                  <TextBlock x:Name="VoiceHotkeyValue"
                             Text="F7"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#2D73D5"
                             TextAlignment="Center"
                             AutomationProperties.AutomationId="voice-hotkey-summary"
                             AutomationProperties.Name="F7" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="字幕窗口"
                           Style="{StaticResource SectionTitleTextStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="打开"
                        MinWidth="78"
                        Click="OnOpenOverlayClicked"
                        AutomationProperties.Name="打开字幕" />
              </Grid>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="透明度"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        x:Name="SubtitleOverlayOpacitySlider"
                        AutomationProperties.AutomationId="subtitle-overlay-opacity"
                        Minimum="60"
                        Maximum="100"
                        StepFrequency="5"
                        SmallChange="5"
                        ValueChanged="OnSubtitleOverlayOpacityChanged"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           x:Name="SubtitleOverlayOpacityValue"
                           Text="90%"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <Grid ColumnSpacing="14" RowSpacing="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="本地语音模型"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#16202E" />
                <TextBlock x:Name="ModelStatus"
                           Text="本地模型未安装"
                           FontSize="12"
                           Foreground="#607083"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button Grid.Column="1"
                      x:Name="ConfigureModelButton"
                      Content="管理模型"
                      Click="OnConfigureModelClicked"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="管理本地语音模型" />
              <ComboBox Grid.Row="1"
                        Grid.ColumnSpan="2"
                        x:Name="SpeechModelBox"
                        AutomationProperties.AutomationId="speech-model-box"
                        SelectedIndex="0"
                        SelectionChanged="OnSpeechModelChanged"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Tag="local" Content="SenseVoice Small · 中 / 英 / 日 / 韩（含粤语）" />
              </ComboBox>
            </Grid>
          </Border>

          <Border Style="{StaticResource SurfaceBorderStyle}" Padding="18,16">
            <StackPanel Spacing="10">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                  <TextBlock Text="说话人"
                             FontSize="17"
                             FontWeight="SemiBold"
                             Foreground="#16202E" />
                  <TextBlock x:Name="SpeakerStatus"
                             Text="字幕暂不区分说话人"
                             FontSize="12"
                             Foreground="#607083"
                             TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              x:Name="SpeakerToggle"
                              AutomationProperties.Name="区分说话人"
                              OnContent="区分"
                              OffContent="不区分"
                              Toggled="OnSpeakerToggleToggled" />
              </Grid>
              <ListView x:Name="SpeakerList"
                        MaxHeight="170"
                        SelectionMode="Single"
                        SelectionChanged="OnSpeakerSelectionChanged"
                        AutomationProperties.AutomationId="speaker-list"
                        BorderThickness="1"
                        CornerRadius="8" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SpeakerRenameButton"
                        Content="命名"
                        Click="OnRenameSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerMergeButton"
                        Content="合并到…"
                        Click="OnMergeSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerForgetButton"
                        Content="忘记"
                        Click="OnForgetSpeakerClicked"
                        IsEnabled="False" />
                <Button x:Name="SpeakerClearButton"
                        Content="清空声纹库"
                        Click="OnClearSpeakersClicked" />
              </StackPanel>
            </StackPanel>
          </Border>

          <InfoBar x:Name="VoiceInfo" IsOpen="False" IsClosable="True" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
