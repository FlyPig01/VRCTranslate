<Page
    x:Class="VrcTranslate.Desktop.Pages.SelfMessagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="Transparent">
    <Grid.Transitions>
      <TransitionCollection>
        <EntranceThemeTransition FromVerticalOffset="10" />
      </TransitionCollection>
    </Grid.Transitions>
    <ScrollViewer x:Name="PageScrollViewer"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                SizeChanged="OnViewportSizeChanged">
    <Grid HorizontalAlignment="Stretch">
      <StackPanel x:Name="ContentColumn"
                  MaxWidth="900"
                  HorizontalAlignment="Center"
                  Spacing="14"
                  Margin="30,24,30,32">

        <!-- One compact status surface makes the start/stop action obvious. -->
        <Border x:Name="SelfVoiceStatusPanel"
                AutomationProperties.AutomationId="self-voice-status-panel"
                Background="#EDF5FF"
                BorderBrush="#C8DCF8"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14,12">
            <Grid x:Name="SelfVoiceStatusGrid" ColumnSpacing="12" RowSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="SelfVoiceIconHost"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#D9E9FF"
                    VerticalAlignment="Center">
              <Grid>
                <FontIcon Glyph="&#xE720;"
                          FontSize="20"
                          Foreground="#2774C7"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                <ProgressRing x:Name="SelfVoicePulse"
                              Width="40"
                              Height="40"
                              IsActive="False"
                              Visibility="Visible"
                              Foreground="#2774C7" />
              </Grid>
            </Border>

            <StackPanel x:Name="SelfVoiceTextHost" Grid.Column="1" Spacing="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="SelfVoiceStatusDot"
                         Width="9"
                         Height="9"
                         Fill="#93A4B8"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="SelfVoiceStatusText"
                           Text="自身语音已关闭"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#16202E" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="SelfVoiceStartButton"
                    AutomationProperties.AutomationId="self-voice-start"
                    Width="92"
                    Height="36"
                    MinWidth="92"
                    Padding="10,0"
                    Content="开始"
                    Background="#247A98"
                    Foreground="#FFFFFF"
                    Click="OnSelfVoiceStartClicked"
                    ToolTipService.ToolTip="开始或停止自身语音识别"
                    AutomationProperties.Name="开始自身语音" />

            <ProgressBar Grid.Row="1"
                         Grid.Column="1"
                         x:Name="MicrophoneLevel"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="4"
                         MaxWidth="280"
                         HorizontalAlignment="Stretch"
                         Margin="0,6,0,0"
                         Background="#C8D8E8"
                         Foreground="#2774C7"
                         IsHitTestVisible="False" />
          </Grid>
        </Border>

        <Grid x:Name="SelfVoiceDetailGrid" ColumnSpacing="14" RowSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="0.85*" />
          </Grid.ColumnDefinitions>

          <!-- Only the controls needed while speaking are shown here. -->
          <Border Grid.Column="0"
                  Style="{StaticResource SurfaceBorderStyle}"
                  Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="语音输入" Style="{StaticResource SectionTitleTextStyle}" />
              <Grid x:Name="VoiceInputGrid" ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Items are populated from active WASAPI endpoints at runtime
                     so connected USB/Bluetooth microphones can be selected. -->
                <ComboBox x:Name="MicrophoneBox"
                          AutomationProperties.AutomationId="self-voice-microphone"
                          Header="麦克风"
                          SelectionChanged="OnSelfVoiceSettingChanged"
                          MinWidth="0" />
                        <Button Grid.Column="1"
                                x:Name="MicrophoneTestButton"
                        Content="检测声音"
                        Click="OnMicrophoneTestClicked"
                        AutomationProperties.Name="检测麦克风声音"
                        VerticalAlignment="Bottom"
                        MinWidth="88" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Style="{StaticResource SurfaceBorderStyle}"
                  Padding="18">
            <StackPanel Spacing="12">
              <TextBlock Text="快捷键" Style="{StaticResource SectionTitleTextStyle}" />
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelfVoiceHotkeySummary"
                           Text="Ctrl+F8"
                           FontSize="16"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="去设置"
                        Click="OnOpenSettingsClicked"
                        AutomationProperties.Name="打开快捷键设置"
                        MinWidth="72" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource SurfaceBorderStyle}"
                Padding="18">
          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="输入框" Style="{StaticResource SectionTitleTextStyle}" />
              <Button Grid.Column="1"
                      Content="打开输入框"
                      Click="OnOpenInputWindowClicked"
                      AutomationProperties.Name="打开输入框"
                      MinWidth="112"
                      Padding="10,0" />
            </Grid>
            <Grid x:Name="TargetLanguageGrid" ColumnSpacing="12" RowSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="第一语言" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        x:Name="PrimaryTargetBox"
                        AutomationProperties.AutomationId="self-primary-target"
                        SelectionChanged="OnTargetLanguageChanged"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Tag="en-US" Content="English" />
                <ComboBoxItem Tag="ja-JP" Content="日本語" />
                <ComboBoxItem Tag="ko-KR" Content="한국어" />
                <ComboBoxItem Tag="zh-CN" Content="简体中文" />
              </ComboBox>
              <TextBlock Grid.Column="2" Text="第二语言" VerticalAlignment="Center" />
              <ComboBox Grid.Column="3"
                        x:Name="SecondaryTargetBox"
                        AutomationProperties.AutomationId="self-secondary-target"
                        SelectionChanged="OnTargetLanguageChanged"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
                <ComboBoxItem Tag="none" Content="不显示" />
                <ComboBoxItem Tag="en-US" Content="English" />
                <ComboBoxItem Tag="ja-JP" Content="日本語" />
                <ComboBoxItem Tag="ko-KR" Content="한국어" />
                <ComboBoxItem Tag="zh-CN" Content="简体中文" />
              </ComboBox>
            </Grid>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="透明度"
                         VerticalAlignment="Center" />
              <Slider Grid.Column="1"
                      x:Name="InputOverlayOpacitySlider"
                      AutomationProperties.AutomationId="input-overlay-opacity"
                      Minimum="60"
                      Maximum="100"
                      StepFrequency="5"
                      SmallChange="5"
                      ValueChanged="OnInputOverlayOpacityChanged"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         x:Name="InputOverlayOpacityValue"
                         Text="90%"
                         TextAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Output preview is useful after a typed or spoken sentence. -->
        <Border Style="{StaticResource SurfaceBorderStyle}"
                Padding="18">
          <StackPanel Spacing="10">
            <TextBlock Text="最近输出" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="原文" Foreground="#718198" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1"
                         x:Name="RecentOriginal"
                         Text="暂无"
                         TextWrapping="Wrap"
                         Foreground="#3D4A5C" />
            </Grid>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="RecentTranslationHeader"
                         Text="英语"
                         Foreground="#718198"
                         VerticalAlignment="Top" />
              <TextBlock Grid.Column="1"
                          x:Name="RecentTranslation"
                         Text="暂无"
                         TextWrapping="Wrap"
                          FontWeight="SemiBold"
                          Foreground="#16202E" />
            </Grid>
            <Grid x:Name="RecentSecondaryRow" ColumnSpacing="12" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="RecentSecondaryLabel"
                         Text="译文 2"
                         Foreground="#718198"
                         VerticalAlignment="Top" />
              <TextBlock Grid.Column="1"
                         x:Name="RecentSecondaryTranslation"
                         Text="暂无"
                         TextWrapping="Wrap"
                         FontWeight="SemiBold"
                         Foreground="#16202E" />
            </Grid>
          </StackPanel>
        </Border>

        <InfoBar x:Name="SelfVoiceInfo" IsOpen="False" IsClosable="True" />
      </StackPanel>
    </Grid>
    </ScrollViewer>
  </Grid>
</Page>
