<Page
    x:Class="VrcTranslate.Desktop.Pages.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" SizeChanged="OnViewportSizeChanged">
    <Grid HorizontalAlignment="Stretch" MinWidth="0">
      <StackPanel x:Name="ContentColumn" MaxWidth="1040" HorizontalAlignment="Center" Spacing="14" Margin="24,20,24,30">
        <Border Style="{StaticResource AccentSurfaceStyle}" Padding="18">
          <StackPanel Spacing="10">
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Grid Width="22" Height="22">
                  <Ellipse Fill="#2AA876" Opacity="0.18" />
                  <Ellipse Width="9" Height="9" Fill="#219B70" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="翻译服务" Style="{StaticResource SectionTitleTextStyle}" />
                <Border Background="#D9F2E8" CornerRadius="5" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="已就绪" Foreground="#167A59" FontSize="12" FontWeight="SemiBold" /></Border>
              </StackPanel>
            </Grid>
            <Grid x:Name="RouteSummaryGrid" ColumnSpacing="24" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel x:Name="RouteSummaryService" Spacing="2" MinWidth="0">
                <TextBlock Text="当前档案" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="RouteName" Text="默认翻译" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel x:Name="RouteSummaryModel" Grid.Column="1" Spacing="2" MinWidth="0">
                <TextBlock Text="使用模型" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="ModelSummary" Text="尚未配置" FontSize="15" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button x:Name="RouteSummaryButton" Grid.Column="2" Content="配置服务" Click="OnOpenTranslationClicked" AutomationProperties.Name="配置翻译服务" AutomationProperties.AutomationId="route-summary-config" />
            </Grid>
          </StackPanel>
        </Border>

        <Grid ColumnSpacing="10" Margin="2,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="开始使用" Style="{StaticResource SectionTitleTextStyle}" />
          <TextBlock Grid.Column="1" Text="选择一种输入方式" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="FeatureGrid" ColumnSpacing="12" RowSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource SurfaceBorderStyle}" Padding="16" MinWidth="0" MinHeight="132">
            <Grid RowSpacing="14">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#E8F0FF"><FontIcon Glyph="&#xE8BD;" FontSize="18" Foreground="#2774C7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Grid Grid.Row="1" ColumnSpacing="10" MinWidth="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="输入" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="打开" Click="OnOpenInputClicked" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="72" AutomationProperties.Name="打开输入框" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}" Padding="16" MinWidth="0" MinHeight="132">
            <Grid RowSpacing="14">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#E6F6F1"><FontIcon Glyph="&#xE720;" FontSize="18" Foreground="#16866E" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Grid Grid.Row="1" ColumnSpacing="10" MinWidth="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="自身语音" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="打开" Click="OnOpenSelfVoiceClicked" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="72" AutomationProperties.Name="打开自身语音" />
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}" Padding="16" MinWidth="0" MinHeight="132">
            <Grid RowSpacing="14">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Border Width="34" Height="34" CornerRadius="9" Background="#FFF2DD"><FontIcon Glyph="&#xE720;" FontSize="18" Foreground="#C7771C" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <Grid Grid.Row="1" ColumnSpacing="10" MinWidth="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="字幕" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="打开" Click="OnOpenVoiceClicked" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="72" AutomationProperties.Name="打开字幕" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
