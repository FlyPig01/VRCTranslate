<Window
    x:Class="VrcTranslate.Desktop.Pages.SubtitleOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="OverlaySurface"
        RequestedTheme="Dark"
        Background="#0B1726"
        MinWidth="360"
        MinHeight="72"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.AutomationId="subtitle-overlay-surface">
    <Grid x:Name="CaptionLayout"
          Margin="10,8"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          AutomationProperties.AutomationId="subtitle-caption-frame">
      <!-- Player-style message list: one message per recognized sentence,
           newest at the bottom, on one dark surface with a hairline between
           messages. The whole client area belongs to the messages - there is no
           icon or status widget competing with them - and the viewer owns pointer
           and wheel scrolling so a long conversation can be read back while new
           messages stick to the bottom for a reader who stays there.
           The list itself is anchored to the top: the first message starts just
           under the title bar and the messages grow downwards, so a surface the
           reader enlarged keeps its captions in the upper part instead of
           stacking them against the bottom edge under a large empty area. Once
           the messages are taller than the surface, the newest one is reached by
           scrolling, exactly as before. -->
      <ScrollViewer x:Name="CaptionScroll"
                    AutomationProperties.AutomationId="subtitle-text"
                    Margin="4,0"
                    Padding="0,2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    VerticalContentAlignment="Top">
        <StackPanel x:Name="CaptionMessages"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" />
      </ScrollViewer>

      <!-- Offered only after the reader scrolled back; nothing moves the view
           away from an older message. -->
      <Button x:Name="NewCaptionHint"
              Content="有新消息"
              Visibility="Collapsed"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,16,8"
              Padding="10,3"
              FontSize="12"
              AutomationProperties.AutomationId="subtitle-new-message" />
    </Grid>
  </Grid>
</Window>
